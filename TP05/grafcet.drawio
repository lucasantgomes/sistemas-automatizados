tSize=11;fontColor=#555555;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="100" y="726" width="160" height="24" as="geometry"/></mxCell><mxCell id="n138" value="EMERGENCIA (cada)" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#b85450;align=right;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="748" width="240" height="24" as="geometry"/></mxCell><mxCell id="n144" value="99" style="fillColor=#f8cecc;strokeColor=#222222;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=16;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="367" y="842" width="56" height="56" as="geometry"/></mxCell><mxCell id="n145" value="ESTADO SEGURO" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#444444;align=right;verticalAlign=middle;fontFamily=Helvetica;fontStyle=2;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="177" y="856" width="182" height="28" as="geometry"/></mxCell><mxCell id="n146" value="ABRIR = 0 ; FECHAR = 0&lt;br&gt;ALARME = 1" style="fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=12;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="449" y="847" width="210" height="46" as="geometry"/></mxCell><mxCell id="n149" value="" style="fillColor=#111111;strokeColor=#111111;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="373" y="947" width="44" height="6" as="geometry"/></mxCell><mxCell id="n150" value="¬EMERGENCIA · RESET · FC_FECHADA" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#0b3d91;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="425" y="937" width="300" height="26" as="geometry"/></mxCell><mxCell id="n151" value="T99" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;align=right;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="315" y="938" width="52" height="24" as="geometry"/></mxCell><mxCell id="n154" value="→ E0" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="405" y="978" width="120" height="24" as="geometry"/></mxCell><mxCell id="n155" value="" style="shape=note;size=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1270" y="110" width="420" height="242" as="geometry"/></mxCell><mxCell id="n156" value="E/S e prioridades" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1278" y="114" width="400" height="22" as="geometry"/></mxCell><mxCell id="n157" value="Entradas: PRESENCA, FC_ABERTA, FC_FECHADA,&lt;br&gt;                EMERGENCIA, RESET&lt;br&gt;Saídas: ABRIR, FECHAR, ALARME&lt;br&gt;&lt;br&gt;Prioridade: as transições T90…T93 para E99&lt;br&gt;têm prioridade; por isso todas as transições&lt;br&gt;normais incluem ¬EMERGENCIA (seleção&lt;br&gt;exclusiva, sem ambiguidade).&lt;br&gt;&lt;br&gt;T3 inclui ¬PRESENCA, então T3 e T4 são&lt;br&gt;exclusivas: havendo presença ao fechar,&lt;br&gt;sempre vence T4 (reabrir) — a segurança&lt;br&gt;da pessoa tem prioridade." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1278" y="138" width="400" height="210" as="geometry"/></mxCell><mxCell id="n158" value="" style="shape=note;size=14;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1270" y="400" width="420" height="178" as="geometry"/></mxCell><mxCell id="n159" value="Estado seguro" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1278" y="404" width="400" height="22" as="geometry"/></mxCell><mxCell id="n160" value="• E99 desliga ABRIR e FECHAR (para o&lt;br&gt;  movimento) e aciona ALARME.&lt;br&gt;• A retomada só ocorre com emergência&lt;br&gt;  liberada + RESET (reconhecimento do&lt;br&gt;  operador) + porta confirmada fechada.&lt;br&gt;• Sem retomada automática: liberar a&lt;br&gt;  emergência sozinho não move a porta.&lt;br&gt;• Presença durante o fechamento reabre&lt;br&gt;  (E3 → E1)." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1278" y="428" width="400" height="146" as="geometry"/></mxCell><mxCell id="e89" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=11;fontColor=#111111;endArrow=none;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n86" target="n88"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e93" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=11;fontColor=#111111;endArrow=none;endFill=1;labelBac