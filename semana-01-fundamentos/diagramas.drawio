keColor=#555555;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="1180" height="535" as="geometry"/></mxCell><mxCell id="n138" value="FRONTEIRA DO SISTEMA — sensores, controlador, válvula solenoide, tubulação e gotejadores" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#444444;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="238" y="114" width="700" height="22" as="geometry"/></mxCell><mxCell id="n139" value="Sensor de umidade&lt;br&gt;do solo" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="150" width="245" height="66" as="geometry"/></mxCell><mxCell id="n140" value="Solo / plantas" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="156" width="175" height="54" as="geometry"/></mxCell><mxCell id="n142" value="Sensor de chuva" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="236" width="245" height="66" as="geometry"/></mxCell><mxCell id="n143" value="Clima" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="242" width="175" height="54" as="geometry"/></mxCell><mxCell id="n145" value="Relógio + programação" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="322" width="245" height="66" as="geometry"/></mxCell><mxCell id="n146" value="Morador&lt;br&gt;(programa)" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="328" width="175" height="54" as="geometry"/></mxCell><mxCell id="n148" value="Botão manual&lt;br&gt;(regar agora / parar)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="408" width="245" height="66" as="geometry"/></mxCell><mxCell id="n149" value="Morador" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="414" width="175" height="54" as="geometry"/></mxCell><mxCell id="n151" value="Sensor de vazão" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="494" width="245" height="66" as="geometry"/></mxCell><mxCell id="n152" value="" style="fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="300" height="410" as="geometry"/></mxCell><mxCell id="n153" value="CONTROLADOR DE IRRIGAÇÃO" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=15;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="640" y="158" width="300" height="26" as="geometry"/></mxCell><mxCell id="n154" value="• REGAR = (umidade &amp;lt; 35 %) AND&lt;br&gt;   janela de horário AND NOT CHUVA&lt;br&gt;• Parar ao atingir 60 % ou após&lt;br&gt;   20 min (limite de segurança)&lt;br&gt;• Manual: regar no máx. 10 min&lt;br&gt;• Vazão ≈ 0 com válvula aberta →&lt;br&gt;   falta d&amp;#x27;água / entupimento&lt;br&gt;• Vazão &amp;gt; 0 com válvula fechada →&lt;br&gt;   vazamento / válvula presa&lt;br&gt;• Sensor de umidade inválido → usar&lt;br&gt;   só o programa por tempo" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="646" y="190" width="288" height="360" as="geometry"/></mxCell><mxCell id="n160" value="Válvula solenoide&lt;br&gt;(NF)" style="fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="1030" y="274" width="190" height="66" as="geometry"/></mxCell><mxCell id="n162" value="Aviso no app /&lt;br&gt;LED" style="fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="1030" y="370" width="190" height="66" as="geometry"/></mxCell><mxCell id="n164" value="Tubulação +&lt;br&gt;gotejadores&lt;br&gt;+ solo&lt;br&gt;(planta)" style="fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1250" y="264" width="145" height="90" as="geometry"/></mxCell><mxCell id="n166" value="Morador" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1450" y="374" width="170" height="58" as="geometry"/></mxCell><mxCell id="n168" value="Plantas" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1450" y="281" width="170" height="56" as="geometry"/></mxCell><mxCell id="n170" value="PERTURBAÇÃO" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#b85450;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1180" y="64" width="260" height="40" as="geometry"/></mxCell><mxCell id="n173" value="" style="shape=note;size=14;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="665" width="530" height="170" as="geometry"/></mxCell><mxCell id="n174" value="FALHAS CONSIDERADAS" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="28" y="671" width="510" height="22" as="geometry"/></mxCell><mxCell id="n175" value="F1 Sensor de umidade com leitura travada → rega demais&lt;br&gt;   ou de menos. Detecção: valor constante por dias.&lt;br&gt;F2 Válvula presa aberta → desperdício/alagamento.&lt;br&gt;   Detecção: vazão com válvula fechada.&lt;br&gt;F3 Falta d&amp;#x27;água na rede → bomba/válvula abre sem vazão.&lt;br&gt;F4 Falta de energia → válvula NF fecha sozinha.&lt;br&gt;Riscos: desperdício de água, alagar a área, matar&lt;br&gt;plantas por falta de água." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="28" y="697" width="510" height="220" as="geometry"/></mxCell><mxCell id="n176" value="" style="shape=note;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="665" width="520" height="170" as="geometry"/></mxCell><mxCell id="n177" value="COMPORTAMENTO SEGURO" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="568" y="671" width="500" height="22" as="geometry"/></mxCell><mxCell id="n178" value="• Estado seguro = válvula FECHADA (normalmente fechada:&lt;br&gt;  sem energia, não há água correndo).&lt;br&gt;• Tempo máximo de irrigação (20 min) mesmo se o sensor&lt;br&gt;  de umidade não chegar a 60 %.&lt;br&gt;• Vazamento detectado: fechar registro geral (válvula&lt;br&gt;  mestre) e notificar.&lt;br&gt;• Sensor inválido: modo degradado por tempo fixo, curto." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="568" y="697" width="500" height="220" as="geometry"/></mxCell><mxCell id="n179" value="" style="shape=note;size=14;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="665" width="530" height="170" as="geometry"/></mxCell><mxCell id="n180" value="CLASSIFICAÇÃO E LEGENDA" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1098" y="671" width="510" height="22" as="geometry"/></mxCell><mxCell id="n181" value="Classificação: AUTOMÁTICO (programado pelo morador),&lt;br&gt;com comando MANUAL. Malha FECHADA pela umidade do&lt;br&gt;solo. Tipo: automação programável (horários e limites&lt;br&gt;alteráveis).&lt;br&gt;MELHORIA proposta: usar previsão do tempo (internet)&lt;br&gt;para pular a rega se houver chuva prevista em 12 h —&lt;br&gt;economia estimada de 20–30 % de água; manter o sensor&lt;br&gt;de chuva local como proteção caso a rede caia." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1098" y="697" width="510" height="220" as="geometry"/></mxCell><mxCell id="n223" value="umidade" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="205" y="147.5" width="50" height="17" as="geometry"/></mxCell><mxCell id="n224" value="precipitação" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="190" y="233.5" width="80" height="17" as="geometry"/></mxCell><mxCell id="n225" value="ajuste" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="208" y="319.5" width="44" height="17" as="geometry"/></mxCell><mxCell id="n226" value="comando" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="205" y="405.5" width="50" height="17" as="geometry"/></mxCell><mxCell id="n227" value="umidade (%)" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="538" y="161.5" width="74" height="17" as="geometry"/></mxCell><mxCell id="n228" value="CHUVA" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="556" y="247.5" width="38" height="17" as="geometry"/></mxCell><mxCell id="n229" value="janela 05h–07h,&lt;br&gt;tempo máx. 20 min" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="520" y="327" width="110" height="30" as="geometry"/></mxCell><mxCell id="n230" value="comando manual" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="529" y="419.5" width="92" height="17" as="geometry"/></mxCell><mxCell id="n231" value="vazão (L/min)" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="532" y="505.5" width="86" height="17" as="geometry"/></mxCell><mxCell id="n232" value="abrir / fechar" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="939" y="285.5" width="92" height="17" as="geometry"/></mxCell><mxCell id="n233" value="falha / vazamento" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="930" y="381.5" width="110" height="17" as="geometry"/></mxCell><mxCell id="n234" value="notificação" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1393" y="359.5" width="74" height="17" as="geometry"/></mxCell><mxCell id="n235" value="água no&lt;br&gt;solo" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1397" y="260" width="50" height="30" as="geometry"/></mxCell><mxCell id="n236" value="sol/calor (evaporação),&lt;br&gt;chuva, vento, pressão da rede" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#b85450;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1126.5" y="169" width="182" height="30" as="geometry"/></mxCell><mxCell id="n237" value="REALIMENTAÇÃO: vazão e umidade resultantes confirmam que a irrigação aconteceu" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f5fa8;align=center;verticalAlign=middle;fontFa