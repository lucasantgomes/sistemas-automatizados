<mxfile host="app.diagrams.net" type="device"><diagram id="pg0" name="Porta automática (obrigatório)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Exercício obrigatório — Porta automática de acesso a um edifício" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=22;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Objetivo: abrir a porta para pessoas autorizadas a passar e fechá-la depois da passagem, sem atingir ninguém,&lt;br&gt;mantendo a rota de fuga livre em emergência. Modelo funcional entrada → processamento → saída." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=14;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1600" height="50" as="geometry"/></mxCell><mxCell id="n4" value="" style="fillColor=none;strokeColor=#555555;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="1180" height="535" as="geometry"/></mxCell><mxCell id="n5" value="FRONTEIRA DO SISTEMA — sensores, controlador, acionamento, motor e folha da porta" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#444444;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="238" y="114" width="700" height="22" as="geometry"/></mxCell><mxCell id="n6" value="Sensor de presença&lt;br&gt;(radar externo/interno)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="150" width="245" height="66" as="geometry"/></mxCell><mxCell id="n7" value="Pessoa que se&lt;br&gt;aproxima" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="156" width="175" height="54" as="geometry"/></mxCell><mxCell id="n9" value="Barreira fotoelétrica&lt;br&gt;na passagem" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="236" width="245" height="66" as="geometry"/></mxCell><mxCell id="n10" value="Pessoa / objeto&lt;br&gt;na passagem" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="242" width="175" height="54" as="geometry"/></mxCell><mxCell id="n12" value="Seletor de modo&lt;br&gt;(AUTO / ABERTA / TRAVADA)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="322" width="245" height="66" as="geometry"/></mxCell><mxCell id="n13" value="Responsável&lt;br&gt;pelo edifício" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="328" width="175" height="54" as="geometry"/></mxCell><mxCell id="n15" value="Botão de emergência /&lt;br&gt;alarme de incêndio" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="408" width="245" height="66" as="geometry"/></mxCell><mxCell id="n16" value="Brigada / central&lt;br&gt;de incêndio" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="414" width="175" height="54" as="geometry"/></mxCell><mxCell id="n18" value="Fins de curso&lt;br&gt;ABERTA / FECHADA" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="494" width="245" height="66" as="geometry"/></mxCell><mxCell id="n19" value="" style="fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="300" height="410" as="geometry"/></mxCell><mxCell id="n20" value="LÓGICA DA PORTA (controlador)" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=15;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="640" y="158" width="300" height="26" as="geometry"/></mxCell><mxCell id="n21" value="• Avaliar autorização: modo AUTO&lt;br&gt;   e presença detectada → ABRIR&lt;br&gt;• Manter aberta enquanto houver&lt;br&gt;   presença ou barreira interrompida&lt;br&gt;• Fechar após 5 s de área livre&lt;br&gt;• Obstáculo ao fechar → PARAR e REABRIR&lt;br&gt;• Emergência → ABRIR e manter aberta&lt;br&gt;• Validar sensores (sinal inválido,&lt;br&gt;   fim de curso não atingido no tempo)&lt;br&gt;• Sinalizar estado e falhas" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="646" y="190" width="288" height="360" as="geometry"/></mxCell><mxCell id="n27" value="Acionamento do&lt;br&gt;motor (driver)" style="fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="1030" y="274" width="190" height="66" as="geometry"/></mxCell><mxCell id="n29" value="Sinalização&lt;br&gt;(LED + sonoro)" style="fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="1030" y="370" width="190" height="66" as="geometry"/></mxCell><mxCell id="n31" value="Motor + correia&lt;br&gt;+ folha da&lt;br&gt;porta&lt;br&gt;(planta)" style="fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1250" y="264" width="145" height="90" as="geometry"/></mxCell><mxCell id="n33" value="Usuários e&lt;br&gt;manutenção" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1450" y="374" width="170" height="58" as="geometry"/></mxCell><mxCell id="n35" value="Pessoa passa" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1450" y="281" width="170" height="56" as="geometry"/></mxCell><mxCell id="n37" value="PERTURBAÇÃO" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#b85450;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1180" y="64" width="260" height="40" as="geometry"/></mxCell><mxCell id="n40" value="" style="shape=note;size=14;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="665" width="530" height="185" as="geometry"/></mxCell><mxCell id="n41" value="FALHAS CONSIDERADAS" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="28" y="671" width="510" height="22" as="geometry"/></mxCell><mxCell id="n42" value="F1 Sensor de presença travado/sinal inválido → porta pode&lt;br&gt;   ficar aberta ou não abrir. Detecção: sinal fora do padrão&lt;br&gt;   ou incoerente por tempo excessivo.&lt;br&gt;F2 Barreira fotoelétrica falha → risco de fechar sobre pessoa.&lt;br&gt;   Detecção: autoteste da barreira antes de cada fechamento.&lt;br&gt;F3 Motor não responde (fim de curso não chega em 8 s).&lt;br&gt;F4 Falta de energia → controlador e motor desligados.&lt;br&gt;F5 Comando indevido de fechar com pessoa na passagem." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="28" y="697" width="510" height="220" as="geometry"/></mxCell><mxCell id="n43" value="" style="shape=note;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="665" width="520" height="185" as="geometry"/></mxCell><mxCell id="n44" value="COMPORTAMENTO SEGURO" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="568" y="671" width="500" height="22" as="geometry"/></mxCell><mxCell id="n45" value="• Sinal inválido de barreira/presença: IMPEDIR fechamento&lt;br&gt;  automático, manter aberta e sinalizar falha.&lt;br&gt;• Obstáculo durante o fechamento: PARAR e REABRIR.&lt;br&gt;• Emergência/incêndio: ABRIR totalmente e manter aberta&lt;br&gt;  (rota de fuga); só volta ao AUTO com rearme manual.&lt;br&gt;• Motor sem resposta: desligar motor e alarmar.&lt;br&gt;• Falta de energia: folha liberada para abertura manual&lt;br&gt;  (estado mecânico seguro)." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="568" y="697" width="500" height="220" as="geometry"/></mxCell><mxCell id="n46" value="" style="shape=note;size=14;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="665" width="530" height="185" as="geometry"/></mxCell><mxCell id="n47" value="CLASSIFICAÇÃO E LEGENDA" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1098" y="671" width="510" height="22" as="geometry"/></mxCell><mxCell id="n48" value="Classificação: AUTOMÁTICO no ciclo normal (detecta,&lt;br&gt;decide e atua sem operador); o modo e o rearme são&lt;br&gt;decisões humanas. Tipo: automação programável simples.&lt;br&gt;&lt;br&gt;Azul = entradas (sensores)   Amarelo = processamento&lt;br&gt;Verde = saídas (atuadores)   Cinza = planta&lt;br&gt;Seta tracejada azul = realimentação (informação)&lt;br&gt;Seta vermelha = perturbação (não controlada)&lt;br&gt;Setas cheias = informação → ação física" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1098" y="697" width="510" height="220" as="geometry"/></mxCell><mxCell id="n182" value="movimento" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="199" y="147.5" width="62" height="17" as="geometry"/></mxCell><mxCell id="n183" value="obstáculo" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="199" y="233.5" width="62" height="17" as="geometry"/></mxCell><mxCell id="n184" value="seleção" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="205" y="319.5" width="50" height="17" as="geometry"/></mxCell><mxCell id="n185" value="emergência" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="196" y="405.5" width="68" height="17" as="geometry"/></mxCell><mxCell id="n186" value="presença detectada" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="517" y="161.5" width="116" height="17" as="geometry"/></mxCell><mxCell id="n187" value="barreira interrompida" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="508" y="247.5" width="134" height="17" as="geometry"/></mxCell><mxCell id="n188" value="modo selecionado" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="523" y="333.5" width="104" height="17" as="geometry"/></mxCell><mxCell id="n189" value="comando prioritário" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="514" y="419.5" width="122" height="17" as="geometry"/></mxCell><mxCell id="n190" value="posição da folha" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="523" y="505.5" width="104" height="17" as="geometry"/></mxCell><mxCell id="n191" value="abrir / fechar /&lt;br&gt;parar" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="933" y="279" width="104" height="30" as="geometry"/></mxCell><mxCell id="n192" value="indicar falha /&lt;br&gt;emergência" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="936" y="375" width="98" height="30" as="geometry"/></mxCell><mxCell id="n193" value="aviso" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1411" y="359.5" width="38" height="17" as="geometry"/></mxCell><mxCell id="n194" value="passagem&lt;br&gt;liberada" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1394" y="260" width="56" height="30" as="geometry"/></mxCell><mxCell id="n195" value="vento, empurrão manual,&lt;br&gt;atrito / sujeira no trilho" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#b85450;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1135.5" y="169" width="164" height="30" as="geometry"/></mxCell><mxCell id="n196" value="REALIMENTAÇÃO: posição real da folha (fins de curso) confirma ou interrompe o movimento" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f5fa8;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="508.9" y="611.85" width="582.2" height="18.3" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.0804878;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.290244;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.709756;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.919512;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.382927;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.617073;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=11;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.477778;entryDx=0;entryDy=0;" edge="1" parent="1" source="n27" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n29" target="n33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontColor=#b85450;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" target="n31"><mxGeometry relative="1" as="geometry"><mxPoint x="1322.5" y="104" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="e39" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f5fa8;strokeWidth=2;fontSize=11;fontColor=#1f5fa8;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1322.5" y="605"/><mxPoint x="387.5" y="605"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pg1" name="Reservatório (adicional 1)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="784" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n49" value="Exercício adicional 1 — Controle automático de nível de um reservatório" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=22;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="34" as="geometry"/></mxCell><mxCell id="n50" value="Objetivo: manter o nível entre 30 % e 80 % ligando a bomba de reposição, evitando transbordamento e operação a seco,&lt;br&gt;com consumo variável. Controle liga/desliga com dois limites (histerese)." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=14;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1600" height="50" as="geometry"/></mxCell><mxCell id="n51" value="" style="fillColor=none;strokeColor=#555555;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="1180" height="449" as="geometry"/></mxCell><mxCell id="n52" value="FRONTEIRA DO SISTEMA — sensor de nível, controlador, bomba, reservatório e tubulações" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#444444;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="238" y="114" width="700" height="22" as="geometry"/></mxCell><mxCell id="n53" value="IHM / parâmetros" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="150" width="245" height="66" as="geometry"/></mxCell><mxCell id="n54" value="Operador" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="156" width="175" height="54" as="geometry"/></mxCell><mxCell id="n56" value="Chave de nível&lt;br&gt;ALTO-ALTO (95%)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="236" width="245" height="66" as="geometry"/></mxCell><mxCell id="n57" value="Chave de nível&lt;br&gt;BAIXO-BAIXO (10%)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="322" width="245" height="66" as="geometry"/></mxCell><mxCell id="n58" value="Transmissor de nível&lt;br&gt;(0–100 %)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="408" width="245" height="66" as="geometry"/></mxCell><mxCell id="n59" value="" style="fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="300" height="324" as="geometry"/></mxCell><mxCell id="n60" value="CONTROLADOR DE NÍVEL" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=15;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="640" y="158" width="300" height="26" as="geometry"/></mxCell><mxCell id="n61" value="• Nível &amp;lt; 30 % → LIGAR bomba&lt;br&gt;• Nível ≥ 80 % → DESLIGAR bomba&lt;br&gt;• Entre 30 % e 80 % → manter estado&lt;br&gt;   anterior (histerese: evita&lt;br&gt;   liga/desliga rápido)&lt;br&gt;• LSHH ativo → DESLIGAR + alarme&lt;br&gt;• Sensor inválido (&amp;lt;0 %, &amp;gt;100 %&lt;br&gt;   ou incoerente com LSHH) → bomba&lt;br&gt;   OFF + alarme de falha" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="646" y="190" width="288" height="274" as="geometry"/></mxCell><mxCell id="n66" value="Contator da&lt;br&gt;bomba" style="fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="1030" y="231" width="190" height="66" as="geometry"/></mxCell><mxCell id="n68" value="Alarme&lt;br&gt;(sinaleiro)" style="fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="1030" y="327" width="190" height="66" as="geometry"/></mxCell><mxCell id="n70" value="Bomba +&lt;br&gt;reservatório&lt;br&gt;(planta)&lt;br&gt;NÍVEL" style="fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1250" y="221" width="145" height="90" as="geometry"/></mxCell><mxCell id="n72" value="Operador" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1450" y="331" width="170" height="58" as="geometry"/></mxCell><mxCell id="n74" value="Consumidores" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1450" y="238" width="170" height="56" as="geometry"/></mxCell><mxCell id="n76" value="PERTURBAÇÃO" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#b85450;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1180" y="64" width="260" height="40" as="geometry"/></mxCell><mxCell id="n79" value="" style="shape=note;size=14;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="579" width="530" height="185" as="geometry"/></mxCell><mxCell id="n80" value="FALHAS CONSIDERADAS" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="28" y="585" width="510" height="22" as="geometry"/></mxCell><mxCell id="n81" value="F1 Transmissor travado em valor baixo → bomba não para:&lt;br&gt;   risco de transbordamento. Detecção: LSHH independente&lt;br&gt;   ativo enquanto o transmissor indica &amp;lt; 80 %.&lt;br&gt;F2 Transmissor travado em valor alto → bomba não liga:&lt;br&gt;   reservatório esvazia. Detecção: LSLL ativo.&lt;br&gt;F3 Sinal fora da faixa (cabo rompido) → valor inválido.&lt;br&gt;F4 Bomba não responde: nível não sobe com bomba ligada&lt;br&gt;   (tempo máximo de enchimento excedido)." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="28" y="611" width="510" height="220" as="geometry"/></mxCell><mxCell id="n82" value="" style="shape=note;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="579" width="520" height="185" as="geometry"/></mxCell><mxCell id="n83" value="COMPORTAMENTO SEGURO" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="568" y="585" width="500" height="22" as="geometry"/></mxCell><mxCell id="n84" value="• Nível ALTO-ALTO (LSHH): desligar bomba por&lt;br&gt;  intertravamento, independente do transmissor, e alarmar.&lt;br&gt;• Sensor inválido/incoerente: bomba DESLIGADA + alarme;&lt;br&gt;  operação só volta após reconhecimento do operador.&lt;br&gt;• LSLL: bloquear funcionamento a seco (sem sucção).&lt;br&gt;• Falta de energia: bomba para (não transborda).&lt;br&gt;• Retorno de energia: não religar sem condições válidas." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="568" y="611" width="500" height="220" as="geometry"/></mxCell><mxCell id="n85" value="" style="shape=note;size=14;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="579" width="530" height="185" as="geometry"/></mxCell><mxCell id="n86" value="CLASSIFICAÇÃO E LEGENDA" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1098" y="585" width="510" height="22" as="geometry"/></mxCell><mxCell id="n87" value="Classificação: AUTOMÁTICO, malha FECHADA (o nível&lt;br&gt;medido governa a bomba). Controle liga/desliga com&lt;br&gt;dois limites. Tipo: automação fixa/programável simples.&lt;br&gt;&lt;br&gt;Se fosse só temporizado (malha aberta), variações de&lt;br&gt;consumo provocariam falta de líquido ou transbordo.&lt;br&gt;Azul = entradas  Amarelo = processamento&lt;br&gt;Verde = saídas   Cinza = planta&lt;br&gt;Tracejado azul = realimentação  Vermelho = perturbação" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1098" y="611" width="510" height="220" as="geometry"/></mxCell><mxCell id="n197" value="ajuste SP" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="199" y="147.5" width="62" height="17" as="geometry"/></mxCell><mxCell id="n198" value="setpoints:&lt;br&gt;liga 30% / desliga 80%" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="505" y="155" width="140" height="30" as="geometry"/></mxCell><mxCell id="n199" value="LSHH" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="559" y="247.5" width="32" height="17" as="geometry"/></mxCell><mxCell id="n200" value="LSLL (proteção&lt;br&gt;da bomba a seco)" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="523" y="327" width="104" height="30" as="geometry"/></mxCell><mxCell id="n201" value="nível medido (%)" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="523" y="419.5" width="104" height="17" as="geometry"/></mxCell><mxCell id="n202" value="ligar / desligar" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="933" y="242.5" width="104" height="17" as="geometry"/></mxCell><mxCell id="n203" value="alto-alto /&lt;br&gt;falha de sensor" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="936" y="332" width="98" height="30" as="geometry"/></mxCell><mxCell id="n204" value="alarme" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1408" y="316.5" width="44" height="17" as="geometry"/></mxCell><mxCell id="n205" value="vazão de&lt;br&gt;consumo" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1394" y="217" width="56" height="30" as="geometry"/></mxCell><mxCell id="n206" value="consumo variável&lt;br&gt;retira líquido" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#b85450;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1165.5" y="147.5" width="104" height="30" as="geometry"/></mxCell><mxCell id="n207" value="REALIMENTAÇÃO: nível resultante retorna ao transmissor (malha fechada)" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f5fa8;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="565" y="525.85" width="470" height="18.3" as="geometry"/></mxCell><mxCell id="e55" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n54" target="n53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e62" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.101852;entryDx=0;entryDy=0;" edge="1" parent="1" source="n53" target="n59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e63" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.367284;entryDx=0;entryDy=0;" edge="1" parent="1" source="n56" target="n59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e64" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.632716;entryDx=0;entryDy=0;" edge="1" parent="1" source="n57" target="n59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e65" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.898148;entryDx=0;entryDy=0;" edge="1" parent="1" source="n58" target="n59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e67" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.351852;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n59" target="n66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e69" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.648148;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n59" target="n68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e71" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=11;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.477778;entryDx=0;entryDy=0;" edge="1" parent="1" source="n66" target="n70"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e73" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n68" target="n72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e75" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=1.5;fontSize=10;fontColor=#111111;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n70" target="n74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e77" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontColor=#b85450;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" target="n70"><mxGeometry relative="1" as="geometry"><mxPoint x="1322.5" y="104" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="e78" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#1f5fa8;strokeWidth=2;fontSize=11;fontColor=#1f5fa8;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n70" target="n58"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1322.5" y="519"/><mxPoint x="387.5" y="519"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="pg2" name="Iluminação (adicional 2)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="855" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n88" value="Exercício adicional 2 — Iluminação automática de estacionamento" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=22;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="34" as="geometry"/></mxCell><mxCell id="n89" value="Objetivo: acender as luminárias somente quando estiver escuro, houver presença e estiver dentro do horário de funcionamento,&lt;br&gt;economizando energia sem deixar pessoas no escuro. Inclui modo manual e falha de sensor." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=14;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1600" height="50" as="geometry"/></mxCell><mxCell id="n90" value="" style="fillColor=none;strokeColor=#555555;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="1180" height="535" as="geometry"/></mxCell><mxCell id="n91" value="FRONTEIRA DO SISTEMA — sensores, relógio, controlador, contatores e luminárias" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#444444;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="238" y="114" width="700" height="22" as="geometry"/></mxCell><mxCell id="n92" value="Fotocélula&lt;br&gt;(luminosidade)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="150" width="245" height="66" as="geometry"/></mxCell><mxCell id="n93" value="Luz natural" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="156" width="175" height="54" as="geometry"/></mxCell><mxCell id="n95" value="Sensores de presença&lt;br&gt;(PIR por setor)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="236" width="245" height="66" as="geometry"/></mxCell><mxCell id="n96" value="Pessoas /&lt;br&gt;veículos" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="242" width="175" height="54" as="geometry"/></mxCell><mxCell id="n98" value="Relógio programável" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="322" width="245" height="66" as="geometry"/></mxCell><mxCell id="n99" value="Calendário" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="328" width="175" height="54" as="geometry"/></mxCell><mxCell id="n101" value="Chave MANUAL&lt;br&gt;(Auto / Liga / Desliga)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="408" width="245" height="66" as="geometry"/></mxCell><mxCell id="n102" value="Vigilante" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="25" y="414" width="175" height="54" as="geometry"/></mxCell><mxCell id="n104" value="Contato auxiliar do&lt;br&gt;contator (retorno)" style="fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="265" y="494" width="245" height="66" as="geometry"/></mxCell><mxCell id="n105" value="" style="fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="300" height="410" as="geometry"/></mxCell><mxCell id="n106" value="LÓGICA DE ILUMINAÇÃO" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=15;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="640" y="158" width="300" height="26" as="geometry"/></mxCell><mxCell id="n107" value="• AUTO: LUZ = ESCURO AND PRESENÇA&lt;br&gt;   AND HORÁRIO&lt;br&gt;• Manter acesa 3 min após última&lt;br&gt;   presença (temporização)&lt;br&gt;• MANUAL: MAN_LIGA → LUZ = 1;&lt;br&gt;   MAN_DESL → LUZ = 0 (prioridade&lt;br&gt;   do modo manual)&lt;br&gt;• Falha da fotocélula ou PIR →&lt;br&gt;   LUZ = 1 se HORÁRIO (seguro)&lt;br&gt;• Comando ≠ retorno → alarme" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="646" y="190" width="288" height="360" as="geometry"/></mxCell><mxCell id="n113" value="Contatores dos&lt;br&gt;circuitos" style="fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="1030" y="274" width="190" height="66" as="geometry"/></mxCell><mxCell id="n115" value="Sinal de falha&lt;br&gt;(painel)" style="fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;rounded=1;" vertex="1" parent="1"><mxGeometry x="1030" y="370" width="190" height="66" as="geometry"/></mxCell><mxCell id="n117" value="Luminárias&lt;br&gt;do estacio-&lt;br&gt;namento&lt;br&gt;(planta)" style="fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1250" y="264" width="145" height="90" as="geometry"/></mxCell><mxCell id="n119" value="Manutenção" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1450" y="374" width="170" height="58" as="geometry"/></mxCell><mxCell id="n121" value="Pessoas" style="ellipse;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1450" y="281" width="170" height="56" as="geometry"/></mxCell><mxCell id="n123" value="PERTURBAÇÃO" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=12;fontColor=#b85450;align=center;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1180" y="64" width="260" height="40" as="geometry"/></mxCell><mxCell id="n126" value="" style="shape=note;size=14;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="665" width="530" height="170" as="geometry"/></mxCell><mxCell id="n127" value="FALHAS CONSIDERADAS" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="28" y="671" width="510" height="22" as="geometry"/></mxCell><mxCell id="n128" value="F1 Fotocélula suja/coberta → sempre &amp;#x27;escuro&amp;#x27; (gasto) ou&lt;br&gt;   sempre &amp;#x27;claro&amp;#x27; (escuro à noite). Detecção: valor&lt;br&gt;   incoerente com o horário (claro às 22h por &amp;gt; 30 min).&lt;br&gt;F2 PIR travado em 1 → luz sempre acesa; travado em 0&lt;br&gt;   → pessoa no escuro. Detecção: sem variação por 24 h.&lt;br&gt;F3 Contator não fecha → comando 1 e retorno 0.&lt;br&gt;F4 Falta de energia → tudo apagado (iluminação de&lt;br&gt;   emergência independente, fora da fronteira)." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="28" y="697" width="510" height="220" as="geometry"/></mxCell><mxCell id="n129" value="" style="shape=note;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="665" width="520" height="170" as="geometry"/></mxCell><mxCell id="n130" value="COMPORTAMENTO SEGURO" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="568" y="671" width="500" height="22" as="geometry"/></mxCell><mxCell id="n131" value="• Na dúvida, ILUMINAR: falha de fotocélula ou PIR dentro&lt;br&gt;  do horário → luzes ACESAS + aviso de manutenção&lt;br&gt;  (segurança de pessoas &amp;gt; economia).&lt;br&gt;• Fora do horário com falha: acender por presença se&lt;br&gt;  o PIR estiver válido.&lt;br&gt;• Comando sem retorno: alarme e tentativa em outro&lt;br&gt;  circuito.&lt;br&gt;• Modo manual sempre disponível ao vigilante." style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="568" y="697" width="500" height="220" as="geometry"/></mxCell><mxCell id="n132" value="" style="shape=note;size=14;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1090" y="665" width="530" height="170" as="geometry"/></mxCell><mxCell id="n133" value="CLASSIFICAÇÃO E LEGENDA" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=13;fontColor=#111111;align=left;verticalAlign=middle;fontFamily=Helvetica;fontStyle=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1098" y="671" width="510" height="22" as="geometry"/></mxCell><mxCell id="n134" value="Classificação: AUTOMÁTICO no modo AUTO, com opção&lt;br&gt;MANUAL (o vigilante pode assumir). Malha ABERTA em&lt;br&gt;relação à iluminância (a luz acesa não muda a decisão),&lt;br&gt;com verificação do comando pelo contato auxiliar.&lt;br&gt;Processamento booleano (modo AUTO):&lt;br&gt;LUZ = ESCURO · PRESENÇA · HORÁRIO&lt;br&gt;Modo manual: LUZ = MAN_LIGA (prioritário)&lt;br&gt;Azul=entradas Amarelo=processamento Verde=saídas" style="text;strokeColor=none;fillColor=none;html=1;whiteSpace=wrap;fontSize=11;fontColor=#111111;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1098" y="697" width="510" height="220" as="geometry"/></mxCell><mxCell id="n208" value="iluminância" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="193" y="147.5" width="74" height="17" as="geometry"/></mxCell><mxCell id="n209" value="movimento" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="199" y="233.5" width="62" height="17" as="geometry"/></mxCell><mxCell id="n210" value="hora" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="214" y="319.5" width="32" height="17" as="geometry"/></mxCell><mxCell id="n211" value="comando" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="205" y="405.5" width="50" height="17" as="geometry"/></mxCell><mxCell id="n212" value="ESCURO (lux &amp;lt; 20)" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="520" y="161.5" width="110" height="17" as="geometry"/></mxCell><mxCell id="n213" value="PRESENÇA" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="547" y="247.5" width="56" height="17" as="geometry"/></mxCell><mxCell id="n214" value="HORÁRIO (06h–23h)" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetica;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="520" y="333.5" width="110" height="17" as="geometry"/></mxCell><mxCell id="n215" value="MAN_LIGA / MAN_DESL" style="text;strokeColor=none;fillColor=none;labelBackgroundColor=#ffffff;html=1;whiteSpace=wrap;fontSize=10;fontColor=#111111;align=center;verticalAlign=middle;fontFamily=Helvetic